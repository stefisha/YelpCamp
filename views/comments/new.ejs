<%- include ('../partials/header') %>
<div class="container">
    <!-- <div class="row"> -->
        <h1 style="text-align: center;">Create a New comment to <%= campground.name %></h1>
        <div style="max-width: 28rem; margin: 25px auto;">
            <form action="/campgrounds/<%= campground._id %>/comments" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <input aria-label="Comment" class="form-control" type="text" maxlength="2000" required name="comment[text]" placeholder="text">
                </div>
                <div class="form-group">
                    <button class="btn btn-large btn-primary btn-block">Submit!</button>
                </div>
            </form>
            <a href="/campgrounds">Go Back!</a>
        </div>

    <!-- </div> -->
</div>
<%- include ('../partials/footer') %>
