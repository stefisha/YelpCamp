<%- include ('../partials/header') %>
<div class="container">
    <!-- <div class="row"> -->
        <h1 style="text-align: center;">Create a New campground</h1>
        <div style="max-width: 28rem; margin: 25px auto;">
            <form action="/campgrounds" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <input aria-label="Campground name" class="form-control" type="text" maxlength="120" required name="name" placeholder="name">
                </div>
                <div class="form-group">
                    <input aria-label="Price per night" class="form-control" type="number" name="price" placeholder="price" min="0" step="0.01">
                </div>
                <div class="form-group">
                    <input aria-label="Image URL" class="form-control" type="text" name="image" placeholder="https://example.com/campground.jpg" required>
                </div>
                <div class="form-group">
                    <input aria-label="Description" class="form-control" type="text" maxlength="5000" required name="description" placeholder="description">
                </div>
                <div class="form-group">
                    <button class="btn btn-large btn-primary btn-block">Submit!</button>
                </div>
            </form>
            <a href="/campgrounds">Go Back!</a>
        </div>

    <!-- </div> -->
</div>
<%- include ('../partials/footer') %>
