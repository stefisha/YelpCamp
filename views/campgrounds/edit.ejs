<%- include ('../partials/header') %>
<div class="container">
    <!-- <div class="row"> -->
        <h1 style="text-align: center;">Edit <%= campground.name %></h1>
        <div style="max-width: 28rem; margin: 25px auto;">
            <form action="/campgrounds/<%= campground._id %>/?_method=PUT" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <input aria-label="Campground name" class="form-control" type="text" maxlength="120" required name="campground[name]" value="<%= campground.name %>">
                </div>
                <div class="form-group">
                    <input aria-label="Price per night" class="form-control" type="number" name="campground[price]" value="<%= campground.price %>" min="0" step="0.01">
                </div>
                <div class="form-group">
                    <input aria-label="Image URL" class="form-control" type="text" name="campground[image]" value="<%= campground.image %>">
                </div>
                <div class="form-group">
                    <input aria-label="Description" class="form-control" type="text" maxlength="5000" required name="campground[description]" value="<%= campground.description %>">
                </div>
                <div class="form-group">
                    <button class="btn btn-large btn-primary btn-block">Submit!</button>
                </div>
            </form>
            <a href="/campgrounds">Go Back!</a>
        </div>

    <!-- </div> -->
</div>
<%- include ('../partials/footer') %>
