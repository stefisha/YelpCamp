<%- include ('./partials/header') %>

<h1 class="text-center">Log In here</h1>

<div class="container">
  <div class="row">
    <div style="max-width: 28rem; margin: 30px auto;">
      <form action="/login" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
            <input aria-label="Username" class="form-control" type="text" name="username" placeholder="username" required>
        </div>
        <div class="form-group">
            <input aria-label="Password" class="form-control" type="password" name="password" placeholder="password" required>
        </div>
        <button class="btn btn-lg btn-success btn-block">Log In</button>
      </form>
    </div>
  </div>
  <p class="text-center">Do not have an account yet? <a href="/register">Sign Up here!</a></p>
</div>

<%- include ('./partials/footer') %>
